{
  "apiVersion": 1,
  "id": "example.ocr",
  "name": "OCR immagini",
  "version": "2.0.0",
  "description": "Riconosce il testo da una foto, permette di correggerlo e lo inserisce nel foglio. OCR locale Android.",
  "runtime": "workflow",
  "permissions": [
    "files.read",
    "ocr",
    "ui",
    "document.write"
  ],
  "commands": [
    {
      "id": "recognize",
      "label": "Riconosci testo",
      "steps": [
        {
          "action": "files.open",
          "args": {
            "type": "image"
          },
          "as": "image"
        },
        {
          "if": {
            "op": "ne",
            "args": [
              {
                "var": "image"
              },
              null
            ]
          },
          "then": [
            {
              "action": "ocr.recognize",
              "args": {
                "var": "image"
              },
              "as": "recognized"
            },
            {
              "action": "ui.form",
              "args": {
                "title": "Correggi il testo",
                "fields": [
                  {
                    "id": "text",
                    "label": "Testo riconosciuto",
                    "type": "text",
                    "multiline": true,
                    "default": {
                      "var": "recognized.text"
                    }
                  }
                ]
              },
              "as": "corrected"
            },
            {
              "if": {
                "op": "ne",
                "args": [
                  {
                    "var": "corrected"
                  },
                  null
                ]
              },
              "then": [
                {
                  "action": "text.add",
                  "args": {
                    "text": {
                      "var": "corrected.text"
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
