{
  "apiVersion": 1,
  "id": "example.latex",
  "name": "Formule LaTeX",
  "version": "2.0.0",
  "description": "Anteprima matematica e inserimento di una formula nel foglio.",
  "runtime": "workflow",
  "permissions": [
    "document.write",
    "ui"
  ],
  "commands": [
    {
      "id": "insert",
      "label": "Inserisci formula",
      "inputs": [
        {
          "id": "formula",
          "label": "LaTeX",
          "type": "text",
          "required": true,
          "multiline": true
        },
        {
          "id": "size",
          "label": "Dimensione",
          "type": "number",
          "default": 24
        }
      ],
      "steps": [
        {
          "action": "tex.add",
          "args": {
            "text": "${input.formula}",
            "size": {
              "var": "input.size"
            }
          }
        }
      ]
    }
  ]
}
