{
  "apiVersion": 1,
  "id": "example.ocr",
  "name": "OCR immagini",
  "version": "2.0.0",
  "description": "Riconosce il testo da una foto, permette di correggerlo e lo inserisce nel foglio. OCR locale Android.",
  "runtime": "javascript",
  "permissions": [
    "files.read",
    "ocr",
    "ui",
    "document.write"
  ],
  "commands": [
    {
      "id": "recognize",
      "label": "Leggi testo da immagine",
      "handler": "recognize"
    }
  ]
}