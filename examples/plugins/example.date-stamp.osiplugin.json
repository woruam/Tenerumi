{
  "apiVersion": 1,
  "id": "example.date-stamp",
  "name": "Timbro data",
  "version": "1.0.0",
  "description": "Aggiunge una data e un titolo personalizzato al foglio.",
  "permissions": [
    "document.write"
  ],
  "commands": [
    {
      "id": "stamp",
      "label": "Inserisci timbro",
      "inputs": [
        {
          "id": "title",
          "label": "Titolo",
          "type": "text",
          "default": "Appunti"
        }
      ],
      "steps": [
        {
          "action": "text.add",
          "args": {
            "text": "${input.title} — ${today}",
            "x": 40,
            "y": 40,
            "size": 20
          }
        }
      ]
    }
  ]
}
